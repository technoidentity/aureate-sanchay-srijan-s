pub fn nth(n: u32) -> u32 {
    let mut prime_numbers:Vec<u32> = Vec::new();
    let mut x = 2;
    while prime_numbers.len() <= n as usize {
        if is_prime(x){
            prime_numbers.push(x);
        }
        x+=1;
    }
    
    *prime_numbers.last().unwrap()
    
}

fn is_prime(n:u32)->bool{
    if n<2{
        return false;
    }
    let limit = (n as f64).sqrt() as u32;

    for i in 2..=limit {
        if n % i == 0 {
            return false;
        }
    }
    true
}
